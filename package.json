{
  "name": "ewms.client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src e2e",
    "lint:fix": "eslint src e2e --fix",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "metrics:duplicates": "jscpd src/app --format typescript,scss,markup --min-lines 10 --min-tokens 70 --reporters console --silent",
    "check:cycles": "node scripts/check-cycles.mjs",
    "fonts:woff2": "node scripts/fonts-woff2.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@microsoft/signalr": "^9.0.19",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.39.5",
    "jscpd": "^5.4.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.0.8",
    "wawoff2": "^2.0.1"
  }
}
